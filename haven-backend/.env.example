# ============================================================
# Haven Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] will prevent the app from starting if missing.
#
# NEVER commit your .env file to version control.
# ============================================================

# ---------- Database [REQUIRED] ----------
# PostgreSQL connection string.
# For Supabase: Settings > Database > Connection string (Session mode)
# For local Docker: postgresql://postgres:haven_dev_password@localhost:5432/haven
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ---------- Supabase [REQUIRED] ----------
# Project URL and keys from Supabase > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ---------- Security [REQUIRED] ----------
# HMAC-SHA256 salt for the two-vault identity hashing (min 8 characters).
# WARNING: Once set, NEVER change this — it breaks identity correlation.
VAULT_SALT=generate-a-random-string-here-min-8-chars

# Fernet encryption key for PII encryption in Vault B (44-char base64 string).
# WARNING: If lost, all encrypted PII becomes unrecoverable.
ENCRYPTION_KEY=generate-a-fernet-key-here

# ---------- JWT [REQUIRED] ----------
# JWT signing secret (minimum 32 characters).
# NEVER use default values like "secret" or "change-me".
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- LLM / AI [REQUIRED for AI features] ----------
# Google Gemini API key for AI chat, intent classification, and sentiment analysis.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---------- GitHub [REQUIRED for GitHub Integration] ----------
# GitHub API Base URL
GITHUB_API_BASE_URL=https://api.github.com
# GitHub Token for API access
GITHUB_TOKEN=your_github_token_here
# Organization to track
GITHUB_ORGANIZATION=your_github_org
# List of repositories
GITHUB_REPOSITORIES=["org/repo1", "org/repo2"]
# Timeouts and retries
GITHUB_REQUEST_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=3
# Working hours configuration
GITHUB_WORKING_TIMEZONE=UTC
GITHUB_WORKDAY_START=09:00
GITHUB_WORKDAY_END=17:00
